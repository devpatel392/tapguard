# Copy to .env and fill in.

# mock = built-in fake wallet, works offline.
# mcp  = talk to an MCP server (scripts/fake_tangem_mcp.py by default, Tangem's on the night).
WALLET_BACKEND=mock
MOCK_TAP_DELAY=1.2

# Leave empty to use the offline scripted agent (fixed commands, no LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# MCP connection. stdio = launch a local command; http = Streamable HTTP URL; sse = legacy SSE URL.
MCP_TRANSPORT=stdio
MCP_COMMAND=python
MCP_ARGS=scripts/fake_tangem_mcp.py
MCP_URL=
MCP_AUTH_TOKEN=
FAKE_TAP_DELAY=1.5
